# Amen Wellness Centre — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Service-role key — server-only (Edge Functions). Never expose in browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Stripe (New York + Paris) ────────────────────────────────────────
STRIPE_SECRET_KEY_NY=sk_test_...
STRIPE_SECRET_KEY_PARIS=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY_NY=pk_test_...
VITE_STRIPE_PUBLISHABLE_KEY_PARIS=pk_test_...
STRIPE_WEBHOOK_SECRET_NY=whsec_...
STRIPE_WEBHOOK_SECRET_PARIS=whsec_...

# ── IntaSend (Nairobi) ───────────────────────────────────────────────
INTASEND_API_KEY=ISSecretKey_test_...
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_...
INTASEND_WEBHOOK_SECRET=...

# ── Resend (email) ───────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Make (automations) ──────────────────────────────────────────────
MAKE_WEBHOOK_BASE_URL=https://hook.us1.make.com/

# ── App ──────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
VITE_ENV=development
